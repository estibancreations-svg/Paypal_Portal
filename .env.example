# PayPal Sandbox credentials — server-side only, never commit a real .env
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox API base (use https://api-m.paypal.com only for Live — not this build)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Webhook ID from the Sandbox app's webhooks (for signature verification)
PAYPAL_WEBHOOK_ID=
# Sandbox recipient email used by the Phase 1 payout proof
PROOF_RECIPIENT_EMAIL=
PORT=8080
